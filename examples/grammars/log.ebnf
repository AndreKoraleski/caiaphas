(* Log lines, such as `2026-10-17 08:30:00 WARN disk almost full`. *)
log = {line, (newline | ? end ?)};
line = date, ' ', time, ' ', level, ' ', message;
(* as String *)
date = ? /\d{4}-\d{2}-\d{2}/ ?;
(* as String *)
time = ? /\d{2}:\d{2}:\d{2}/ ?;
(* as Level *)
level = 'TRACE' | 'DEBUG' | 'INFO' | 'WARN' | 'ERROR';
(* as String *)
message = ? /[^\r\n]*/ ?;
(* hide *)
newline = ? /\r{0,1}\n/ ?;
