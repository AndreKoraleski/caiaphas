(* An INI file: sections, properties and comments, one on each line. *)
ini = [entry], {newline, [entry]};
entry = section | property | comment;
section = '[', ws, name, ws, ']', ws;
property = name, ws, '=', ws, [value];
comment = (';' | '#'), {character};
(* as String *)
name = letter, {letter | digit | '_' | '-' | '.'};
value = visible, {character};
(* hide *)
visible = ? U+0021..U+007E ? | ? U+00A0..U+10FFFF ?;
(* hide *)
character = visible | ' ' | ? U+0009 ?;
(* hide *)
letter = ? U+0041..U+005A ? | ? U+0061..U+007A ?;
(* hide *)
digit = ? U+0030..U+0039 ?;
(* hide *)
newline = [? U+000D ?], ? U+000A ?;
(* hide *)
ws = {' ' | ? U+0009 ?};
