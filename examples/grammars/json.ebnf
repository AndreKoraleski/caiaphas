(* JSON, as RFC 8259 describes it, with each number read as an f64. *)
json = ws, value, ws;
value = object | array | string | number | 'true' | 'false' | 'null';
object = '{', ws, [member, ws, {',', ws, member, ws}], '}';
member = string, ws, ':', ws, value;
array = '[', ws, [value, ws, {',', ws, value, ws}], ']';
string = '"', {character}, '"';
(* hide *)
character = ? U+0020..U+0021 ? | ? U+0023..U+005B ? | ? U+005D..U+10FFFF ?
          | '\', escape;
(* hide *)
escape = '"' | '\' | '/' | 'b' | 'f' | 'n' | 'r' | 't' | 'u', 4 * hex;
(* hide *)
hex = ? U+0030..U+0039 ? | ? U+0041..U+0046 ? | ? U+0061..U+0066 ?;
(* as f64 *)
number = ['-'], integer, [fraction], [exponent];
integer = '0' | ? U+0031..U+0039 ?, {digit};
(* hide *)
digit = ? U+0030..U+0039 ?;
fraction = '.', digit, {digit};
exponent = ('e' | 'E'), ['+' | '-'], digit, {digit};
(* hide *)
ws = {' ' | ? U+0009 ? | ? U+000A ? | ? U+000D ?};
