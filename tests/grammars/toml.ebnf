(* TOML 1.0, after the ABNF of its specification. *)
toml = expression, {newline, expression};
expression = ws, [(key value | table), ws], [comment];

(* hide *)
ws = {' ' | ? U+0009 ?};
(* hide *)
newline = ? /\r{0,1}\n/ ?;
(* hide *)
comment = '#', ? /[^U+0000-U+0008U+000A-U+001FU+007F]*/ ?;

(* Keys and values *)
key value = key, ws, '=', ws, value;
key = simple key, {ws, '.', ws, simple key};
simple key = quoted key | unquoted key;
unquoted key = ? /[A-Za-z0-9_-]+/ ?;
quoted key = basic string | literal string;
value = string | boolean | array | inline table | date time | float
      | integer;

(* Strings *)
string = multiline basic string | basic string | multiline literal string
       | literal string;
basic string = '"', {basic character | escaped}, '"';
(* hide *)
basic character = ? /[^"\\U+0000-U+0008U+000A-U+001FU+007F]/ ?;
(* hide *)
escaped = '\', (? /["\\bfnrt]/ ? | 'u', 4 * hex | 'U', 8 * hex);
(* hide *)
hex = ? /[0-9A-Fa-f]/ ?;
(* expect ambiguous-split: a line break right after the quotes is trimmed, as
   the specification says *)
multiline basic string = '"""', [newline], multiline basic body, '"""';
(* hide *)
multiline basic body = {multiline basic content},
                       {quotes, multiline basic content,
                        {multiline basic content}},
                       [quotes];
(* hide *)
multiline basic content = basic character | escaped | newline
                        | '\', ws, newline, {? /\s/ ?};
(* hide *)
quotes = '"', ['"'];
literal string = "'", {literal character}, "'";
(* hide *)
literal character = ? /[^'U+0000-U+0008U+000A-U+001FU+007F]/ ?;
(* expect ambiguous-split: a line break right after the quotes is trimmed, as
   the specification says *)
multiline literal string = "'''", [newline], multiline literal body, "'''";
(* hide *)
multiline literal body = {multiline literal content},
                         {apostrophes, multiline literal content,
                          {multiline literal content}},
                         [apostrophes];
(* hide *)
multiline literal content = literal character | newline;
(* hide *)
apostrophes = "'", ["'"];

(* Numbers *)
integer = hexadecimal | octal | binary | decimal;
decimal = ['+' | '-'], unsigned decimal;
(* hide *)
unsigned decimal = '0' | ? /[1-9](_{0,1}[0-9])*/ ?;
hexadecimal = '0x', ? /[0-9A-Fa-f](_{0,1}[0-9A-Fa-f])*/ ?;
octal = '0o', ? /[0-7](_{0,1}[0-7])*/ ?;
binary = '0b', ? /[01](_{0,1}[01])*/ ?;
float = decimal, (fraction, [exponent] | exponent)
      | ['+' | '-'], ('inf' | 'nan');
(* hide *)
fraction = '.', digits;
(* hide *)
exponent = ('e' | 'E'), ['+' | '-'], digits;
(* hide *)
digits = ? /[0-9](_{0,1}[0-9])*/ ?;
boolean = 'true' | 'false';

(* Dates and times *)
date time = offset date time | local date time | local date | local time;
offset date time = full date, time separator, full time, offset;
local date time = full date, time separator, full time;
local date = full date;
local time = full time;
(* hide *)
full date = ? /\d{4}-\d{2}-\d{2}/ ?;
(* hide *)
time separator = 'T' | 't' | ' ';
(* hide *)
full time = ? /\d{2}:\d{2}:\d{2}(\.\d+){0,1}/ ?;
(* hide *)
offset = 'Z' | 'z' | ? /[+-]\d{2}:\d{2}/ ?;

(* Arrays and tables *)
array = '[', blank, [array values], ']';
(* hide *)
array values = value, blank, {',', blank, value, blank}, [',', blank];
(* hide *)
blank = {? /[ U+0009]/ ? | [comment], newline};
inline table = '{', ws, [key value, ws, {',', ws, key value, ws}], '}';
table = standard table | array table;
standard table = '[', ws, key, ws, ']';
array table = '[[', ws, key, ws, ']]';
